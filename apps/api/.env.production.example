NODE_ENV=production
PORT=3000
CORS_ORIGINS=https://admin.example.com
DATABASE_URL=postgresql://user:password@postgres:5432/looptodo
REDIS_URL=redis://redis:6379
JWT_ACCESS_SECRET=replace-with-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-different-random-secret-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
PAYMENT_PROVIDER=http
PAYMENT_API_URL=https://payments.example.com/orders
PAYMENT_API_KEY=replace-with-payment-provider-key
PAYMENT_WEBHOOK_SECRET=replace-with-payment-webhook-secret-at-least-32-characters
AI_PROVIDER=http
AI_API_URL=https://ai.example.com/answer
AI_API_KEY=replace-with-ai-provider-key
REWARD_ADDRESS_ENCRYPTION_KEY=replace-with-address-encryption-key-at-least-32-characters
ADMIN_EMAILS=admin@example.com
SCORING_FORMULA_VERSION=v2-stars
SCORING_DURATION_WEIGHT=0.6
SCORING_STREAK_POINTS_PER_DAY=3
SCORING_HIGH_TRUST_POINTS=10
SCORING_NORMAL_TRUST_POINTS=7
SCORING_UNTIMED_POINTS=5
SCORING_EMERGENCY_EXIT_PENALTY=-30
RANK_THRESHOLDS_JSON=[0,500,1500,3000,5000,8000]
TEAM_AVERAGE_WEIGHT=0.7
TEAM_TOTAL_BONUS_WEIGHT=0.3
