generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VipStatus {
  free
  active
  expired
}

enum TaskType {
  pomodoro
  goal
}

enum TimerMode {
  countdown
  countup
  untimed
}

enum TaskStatus {
  pending
  active
  completed
  failed
  archived
}

enum SessionMode {
  focus
  lock
}

enum TrustLevel {
  high
  normal
  open
  invalid
}

enum FocusOutcome {
  completed
  failed
  cancelled
  emergency_exit
}

enum HabitStatus {
  active
  archived
}

enum DevicePlatform {
  android
  ios
}

enum PushProvider {
  fcm
  vendor
  test
}

enum NotificationDeliveryStatus {
  pending
  processing
  delivered
  failed
  cancelled
}

enum ResourceType {
  url
  domain
  local_file
  local_video
  ai_material
}

enum FriendshipStatus {
  pending
  accepted
  blocked
}

enum PkMatchStatus {
  active
  completed
}

enum StudyRoomVisibility {
  public
  private
}

enum SeasonStatus {
  active
  settled
}

enum TeamRole {
  leader
  member
}

enum SubscriptionPlan {
  monthly
  quarterly
  yearly
}

enum SubscriptionOrderStatus {
  pending
  paid
  failed
  cancelled
}

enum PaymentProvider {
  http
  test
}

enum FamilyRole {
  parent
  child
}

enum FamilyAssignmentStatus {
  active
  completed
  cancelled
}

enum TaskChangeRequestType {
  update
  delete
}

enum TaskChangeRequestStatus {
  pending
  approved
  rejected
}

enum RewardType {
  virtual
  physical
}

enum RewardClaimStatus {
  pending
  accepted
  declined
  fulfilled
}
enum NetworkPolicy {
  offline_first
  online_required
}

enum RestrictionMode {
  none
  whitelist
  strict
}

enum WhitelistMode {
  list
  custom
}

model User {
  id                       String          @id @default(uuid()) @db.Uuid
  email                    String          @unique @db.VarChar(320)
  passwordHash             String          @map("password_hash")
  nickname                 String          @db.VarChar(80)
  avatarUrl                String?         @map("avatar_url")
  vipStatus                VipStatus       @default(free) @map("vip_status")
  privacySettings          Json            @default("{}") @map("privacy_settings")
  multiDeviceFocusSync     Boolean         @default(false) @map("multi_device_focus_sync")
  bottomTabs               String[]        @default(["habits", "statistics"]) @map("bottom_tabs")
  shareCurrentTask         Boolean         @default(false) @map("share_current_task")
  shareCompletedTasks      Boolean         @default(false) @map("share_completed_tasks")
  isAdmin                  Boolean         @default(false) @map("is_admin")
  networkPolicy            NetworkPolicy   @default(offline_first) @map("network_policy")
  taskRemindersEnabled     Boolean         @default(true) @map("task_reminders_enabled")
  familyAlertsEnabled      Boolean         @default(true) @map("family_alerts_enabled")
  rewardNotificationsEnabled Boolean       @default(true) @map("reward_notifications_enabled")
  createdAt                DateTime        @default(now()) @map("created_at")
  updatedAt                DateTime        @updatedAt @map("updated_at")
  deviceSessions           DeviceSession[]
  taskCategories           TaskCategory[]
  whitelistLists          WhitelistList[]
  whitelistMutations      WhitelistMutation[]
  tasks                    Task[]
  focusSessions            FocusSession[]
  habits                   Habit[]
  habitProgressEntries     HabitProgressEntry[]
  taskProgressEntries      TaskProgressEntry[]
  forcedLockRules          ForcedLockRule[]
  devices                  Device[]
  notificationEvents       NotificationEvent[]
  resourcePasses           ResourcePass[]
  aiMaterials              AiMaterial[]
  aiAudits                 AiAudit[]
  scoreEvents              ScoreEvent[]
  friendshipsRequested     Friendship[]    @relation("FriendshipRequester")
  friendshipsReceived      Friendship[]    @relation("FriendshipAddressee")
  pkMatchesCreated         PkMatch[]        @relation("PkChallenger")
  pkMatchesReceived        PkMatch[]        @relation("PkOpponent")
  studyRoomsOwned          StudyRoom[]      @relation("StudyRoomOwner")
  studyRoomMemberships     StudyRoomMember[]
  studyRoomReactions       StudyRoomReaction[]
  rankSnapshots            RankSnapshot[]
  teamMembership           TeamMember?
  teamsLed                 Team[]            @relation("TeamLeader")
  subscriptions            Subscription[]
  subscriptionOrders       SubscriptionOrder[]
  paymentAudits            PaymentAudit[]
  familyMemberships        FamilyMember[]
  familyGroupsCreated      FamilyGroup[]      @relation("FamilyGroupCreator")
  familyInvitesUsed        FamilyInvite[]     @relation("FamilyInviteUser")
  familyChangeReviews      TaskChangeRequest[] @relation("FamilyChangeReviewer")
  rewardClaims             RewardClaim[]
  rewardAddress            RewardAddress?
  rewardAudits             RewardAudit[]
  securityEvents           SecurityEvent[]
  blocksCreated            UserBlock[]       @relation("UserBlocksCreated")
  blocksReceived           UserBlock[]       @relation("UserBlocksReceived")

  @@map("users")
}

model Device {
  id          String                 @id @default(uuid()) @db.Uuid
  userId      String                 @map("user_id") @db.Uuid
  platform    DevicePlatform
  deviceName  String                 @map("device_name") @db.VarChar(120)
  pushToken   String                 @map("push_token") @db.VarChar(512)
  provider    PushProvider
  appVersion  String?                @map("app_version") @db.VarChar(40)
  enabled     Boolean                @default(true)
  lastSeenAt  DateTime               @default(now()) @map("last_seen_at")
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")
  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries  NotificationDelivery[]

  @@unique([userId, pushToken])
  @@index([userId, enabled])
  @@map("devices")
}

model NotificationEvent {
  id          String                 @id @default(uuid()) @db.Uuid
  userId      String                 @map("user_id") @db.Uuid
  type        String                 @db.VarChar(48)
  title       String                 @db.VarChar(160)
  body        String
  data        Json                   @default("{}")
  dedupeKey   String                 @map("dedupe_key") @db.VarChar(180)
  scheduledAt DateTime               @map("scheduled_at")
  createdAt   DateTime               @default(now()) @map("created_at")
  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries  NotificationDelivery[]

  @@unique([userId, dedupeKey])
  @@index([scheduledAt])
  @@map("notification_events")
}

model NotificationDelivery {
  id            String                     @id @default(uuid()) @db.Uuid
  eventId       String                     @map("event_id") @db.Uuid
  deviceId      String                     @map("device_id") @db.Uuid
  status        NotificationDeliveryStatus @default(pending)
  attempts      Int                        @default(0)
  nextAttemptAt DateTime                   @map("next_attempt_at")
  providerId    String?                    @map("provider_id") @db.VarChar(240)
  lastError     String?                    @map("last_error")
  deliveredAt   DateTime?                  @map("delivered_at")
  createdAt     DateTime                   @default(now()) @map("created_at")
  updatedAt     DateTime                   @updatedAt @map("updated_at")
  event         NotificationEvent          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  device        Device                     @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([eventId, deviceId])
  @@index([status, nextAttemptAt])
  @@map("notification_deliveries")
}

model TaskCategory {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String   @db.VarChar(80)
  color     String?  @db.VarChar(32)
  archived  Boolean  @default(false)
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@unique([userId, name])
  @@index([userId, updatedAt])
  @@map("task_categories")
}

model WhitelistList {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  name       String    @db.VarChar(80)
  packages   String[]  @default([])
  isDefault  Boolean   @default(false) @map("is_default")
  version    Int       @default(1)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  archivedAt DateTime? @map("archived_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks      Task[]

  @@index([userId, updatedAt])
  @@map("whitelist_lists")
}

model WhitelistMutation {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  idempotencyKey String   @map("idempotency_key") @db.VarChar(160)
  fingerprint    String   @db.Char(64)
  response       Json
  createdAt      DateTime @default(now()) @map("created_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@map("whitelist_mutations")
}

model Task {
  id                      String         @id @default(uuid()) @db.Uuid
  userId                  String         @map("user_id") @db.Uuid
  categoryId              String?        @map("category_id") @db.Uuid
  title                   String         @db.VarChar(240)
  taskType                TaskType       @map("task_type")
  timerMode               TimerMode      @map("timer_mode")
  estimatedMinutes        Int            @map("estimated_minutes")
  restMinutes             Int            @default(5) @map("rest_minutes")
  deadlineAt              DateTime?      @map("deadline_at")
  targetAmount            Decimal?       @map("target_amount") @db.Decimal(12, 2)
  targetUnit              String?        @map("target_unit") @db.VarChar(40)
  completedAmount         Decimal        @default(0) @map("completed_amount") @db.Decimal(12, 2)
  isTodayRequired         Boolean        @default(false) @map("is_today_required")
  forcedTriggerTime       String?        @map("forced_trigger_time") @db.Char(5)
  restrictionMode         RestrictionMode @default(whitelist) @map("restriction_mode")
  whitelistMode           WhitelistMode  @default(list) @map("whitelist_mode")
  whitelistListId         String?        @map("whitelist_list_id") @db.Uuid
  whitelistPackages       String[]       @default([]) @map("whitelist_packages")
  status                  TaskStatus     @default(pending)
  activeSessionId         String?        @map("active_session_id") @db.Uuid
  version                 Int            @default(1)
  createdByFamilyMemberId String?        @map("created_by_family_member_id") @db.Uuid
  createdAt               DateTime       @default(now()) @map("created_at")
  updatedAt               DateTime       @updatedAt @map("updated_at")
  user                    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  category                TaskCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  whitelistList           WhitelistList? @relation(fields: [whitelistListId], references: [id], onDelete: Restrict)
  focusSessions           FocusSession[]
  taskProgressEntries     TaskProgressEntry[]
  forcedLockRules         ForcedLockRule[]
  resourcePasses          ResourcePass[]
  aiMaterials             AiMaterial[]
  aiAudits                AiAudit[]
  familyAssignment        FamilyTaskAssignment?
  createdByFamilyMember   FamilyMember? @relation("FamilyTaskCreator", fields: [createdByFamilyMemberId], references: [id], onDelete: SetNull)

  @@index([userId, status, updatedAt])
  @@index([userId, activeSessionId])
  @@index([userId, whitelistListId])
  @@map("tasks")
}

model ResourcePass {
  id               String       @id @default(uuid()) @db.Uuid
  userId           String       @map("user_id") @db.Uuid
  taskId           String       @map("task_id") @db.Uuid
  resourceType     ResourceType @map("resource_type")
  resourceValue    String       @map("resource_value")
  trustWeight      Int          @default(100) @map("trust_weight")
  addedDuringFocus Boolean      @default(false) @map("added_during_focus")
  auditReason      String?      @map("audit_reason")
  createdAt        DateTime     @default(now()) @map("created_at")
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  task             Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId, taskId, createdAt])
  @@map("resource_passes")
}

model AiMaterial {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  taskId      String   @map("task_id") @db.Uuid
  title       String   @db.VarChar(160)
  content     String
  contentHash String   @map("content_hash") @db.Char(64)
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId, taskId, createdAt])
  @@map("ai_materials")
}

model AiAudit {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  taskId           String   @map("task_id") @db.Uuid
  questionHash     String   @map("question_hash") @db.Char(64)
  materialIds      Json     @map("material_ids")
  provider         String   @db.VarChar(40)
  externalDataUsed Boolean  @default(false) @map("external_data_used")
  blocked          Boolean  @default(false)
  blockReason      String?  @map("block_reason") @db.VarChar(120)
  createdAt        DateTime @default(now()) @map("created_at")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  task             Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId, taskId, createdAt])
  @@map("ai_audits")
}

model TaskProgressEntry {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  taskId         String   @map("task_id") @db.Uuid
  amount         Decimal  @db.Decimal(12, 2)
  idempotencyKey String   @map("idempotency_key") @db.VarChar(160)
  createdAt      DateTime @default(now()) @map("created_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  task           Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([taskId, createdAt])
  @@map("task_progress_entries")
}

model Habit {
  id                  String               @id @default(uuid()) @db.Uuid
  userId              String               @map("user_id") @db.Uuid
  name                String               @db.VarChar(120)
  targetMinutes       Int                  @map("target_minutes")
  forceEnabled        Boolean              @default(false) @map("force_enabled")
  triggerTime         String?              @map("trigger_time") @db.Char(5)
  status              HabitStatus          @default(active)
  version             Int                  @default(1)
  progressUpdatedAt   DateTime?            @map("progress_updated_at")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  progressEntries     HabitProgressEntry[]
  forcedLockRule      ForcedLockRule?

  @@index([userId, status, updatedAt])
  @@map("habits")
}

model HabitProgressEntry {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  habitId        String   @map("habit_id") @db.Uuid
  minutes        Int
  progressDate   DateTime @map("progress_date") @db.Date
  idempotencyKey String   @map("idempotency_key") @db.VarChar(160)
  createdAt      DateTime @default(now()) @map("created_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  habit          Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([habitId, progressDate])
  @@map("habit_progress_entries")
}

model ForcedLockRule {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  taskId        String?  @map("task_id") @db.Uuid
  habitId       String?  @unique @map("habit_id") @db.Uuid
  triggerTime   String   @map("trigger_time") @db.Char(5)
  bufferMinutes Int      @default(10) @map("buffer_minutes")
  maxDelayCount Int      @default(2) @map("max_delay_count")
  delayMinutes  Int      @default(20) @map("delay_minutes")
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  task          Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  habit         Habit?   @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@index([userId, enabled])
  @@map("forced_lock_rules")
}

model FocusSession {
  id                   String        @id @default(uuid()) @db.Uuid
  userId               String        @map("user_id") @db.Uuid
  taskId               String        @map("task_id") @db.Uuid
  mode                 SessionMode
  timerMode            TimerMode     @map("timer_mode")
  trustLevel           TrustLevel    @default(normal) @map("trust_level")
  startedAt            DateTime      @map("started_at")
  endedAt              DateTime?     @map("ended_at")
  plannedMinutes       Int           @map("planned_minutes")
  actualMinutes        Int?          @map("actual_minutes")
  restrictionMode      RestrictionMode @default(none) @map("restriction_mode")
  whitelistSource      String        @default("none") @map("whitelist_source") @db.VarChar(160)
  whitelistPackageCount Int          @default(0) @map("whitelist_package_count")
  allowedPackagesSnapshot String[]   @default([]) @map("allowed_packages_snapshot")
  restrictionEffective Boolean       @default(false) @map("restriction_effective")
  effectiveMinutes     Int           @default(0) @map("effective_minutes")
  outcome              FocusOutcome?
  completionNote       String?       @map("completion_note")
  failureReasonType    String?       @map("failure_reason_type") @db.VarChar(80)
  failureReasonText    String?       @map("failure_reason_text")
  startIdempotencyKey  String        @map("start_idempotency_key") @db.VarChar(160)
  finishIdempotencyKey String?       @map("finish_idempotency_key") @db.VarChar(160)
  syncedAt             DateTime?     @map("synced_at")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  task                 Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  scoreEvent           ScoreEvent?

  @@unique([userId, startIdempotencyKey])
  @@unique([userId, finishIdempotencyKey])
  @@index([userId, updatedAt])
  @@index([taskId, endedAt])
  @@map("focus_sessions")
}

model ScoreEvent {
  id              String       @id @default(uuid()) @db.Uuid
  userId          String       @map("user_id") @db.Uuid
  seasonId        String?      @map("season_id") @db.Uuid
  sessionId       String       @unique @map("session_id") @db.Uuid
  scoreDate       DateTime     @map("score_date") @db.Date
  outcome         FocusOutcome
  trustLevel      TrustLevel   @map("trust_level")
  durationMinutes Int          @map("duration_minutes")
  streakDays      Int          @map("streak_days")
  durationScore   Int          @map("duration_score")
  streakScore     Int          @map("streak_score")
  trustScore      Int          @map("trust_score")
  penaltyScore    Int          @default(0) @map("penalty_score")
  totalScore      Int          @map("total_score")
  formulaVersion  String       @map("formula_version") @db.VarChar(40)
  streakAwardKey  String?      @unique @map("streak_award_key") @db.VarChar(80)
  createdAt       DateTime     @default(now()) @map("created_at")
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  session         FocusSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  season          Season?      @relation(fields: [seasonId], references: [id], onDelete: SetNull)

  @@index([userId, scoreDate])
  @@index([seasonId, totalScore])
  @@map("score_events")
}

model Season {
  id            String         @id @default(uuid()) @db.Uuid
  name          String         @db.VarChar(80)
  startsAt      DateTime       @unique @map("starts_at")
  endsAt        DateTime       @map("ends_at")
  status        SeasonStatus   @default(active)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  scoreEvents   ScoreEvent[]
  rankSnapshots RankSnapshot[]

  @@index([status, endsAt])
  @@map("seasons")
}

model RankSnapshot {
  id        String   @id @default(uuid()) @db.Uuid
  seasonId  String   @map("season_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  score     Int
  tier      String   @db.VarChar(32)
  position  Int
  createdAt DateTime @default(now()) @map("created_at")
  season    Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([seasonId, userId])
  @@index([seasonId, position])
  @@index([userId, createdAt])
  @@map("rank_snapshots")
}

model Team {
  id          String       @id @default(uuid()) @db.Uuid
  leaderId    String       @map("leader_id") @db.Uuid
  name        String       @unique @db.VarChar(120)
  joinCode    String       @unique @map("join_code") @db.VarChar(16)
  memberCount Int          @default(0) @map("member_count")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  leader      User         @relation("TeamLeader", fields: [leaderId], references: [id], onDelete: Restrict)
  members     TeamMember[]

  @@map("teams")
}

model TeamMember {
  id        String   @id @default(uuid()) @db.Uuid
  teamId    String   @map("team_id") @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  role      TeamRole @default(member)
  joinedAt  DateTime @default(now()) @map("joined_at")
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([teamId, joinedAt])
  @@map("team_members")
}

model Subscription {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  plan            SubscriptionPlan
  startsAt        DateTime         @map("starts_at")
  expiresAt       DateTime         @map("expires_at")
  providerOrderId String           @unique @map("provider_order_id") @db.VarChar(160)
  createdAt       DateTime         @default(now()) @map("created_at")
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("subscriptions")
}

model SubscriptionOrder {
  id              String                  @id @default(uuid()) @db.Uuid
  userId          String                  @map("user_id") @db.Uuid
  plan            SubscriptionPlan
  amountCents     Int                     @map("amount_cents")
  currency        String                  @default("CNY") @db.Char(3)
  provider        PaymentProvider
  status          SubscriptionOrderStatus @default(pending)
  idempotencyKey  String                  @map("idempotency_key") @db.VarChar(160)
  externalOrderId String?                 @unique @map("external_order_id") @db.VarChar(160)
  checkoutUrl     String?                 @map("checkout_url")
  paidAt          DateTime?               @map("paid_at")
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")
  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@map("subscription_orders")
}

model PaymentAudit {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  orderId     String?  @map("order_id") @db.Uuid
  eventId     String   @unique @map("event_id") @db.VarChar(160)
  payloadHash String   @map("payload_hash") @db.Char(64)
  verified    Boolean
  result      String   @db.VarChar(80)
  createdAt   DateTime @default(now()) @map("created_at")
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@map("payment_audits")
}

model FamilyGroup {
  id          String                 @id @default(uuid()) @db.Uuid
  name        String                 @db.VarChar(120)
  createdById String                 @map("created_by_id") @db.Uuid
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")
  createdBy   User                   @relation("FamilyGroupCreator", fields: [createdById], references: [id], onDelete: Restrict)
  members     FamilyMember[]
  invites     FamilyInvite[]
  assignments FamilyTaskAssignment[]

  @@map("family_groups")
}

model FamilyMember {
  id                 String                 @id @default(uuid()) @db.Uuid
  familyGroupId      String                 @map("family_group_id") @db.Uuid
  userId             String                 @map("user_id") @db.Uuid
  role               FamilyRole
  joinedAt           DateTime               @default(now()) @map("joined_at")
  leftAt             DateTime?              @map("left_at")
  familyGroup        FamilyGroup            @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)
  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAsParent   FamilyTaskAssignment[] @relation("FamilyAssignmentParent")
  assignedAsChild    FamilyTaskAssignment[] @relation("FamilyAssignmentChild")
  tasksCreated       Task[]                 @relation("FamilyTaskCreator")
  changeRequests     TaskChangeRequest[]    @relation("FamilyChangeChild")

  @@unique([familyGroupId, userId])
  @@index([userId, leftAt])
  @@map("family_members")
}

model FamilyInvite {
  id            String      @id @default(uuid()) @db.Uuid
  familyGroupId String      @map("family_group_id") @db.Uuid
  role          FamilyRole
  codeHash      String      @unique @map("code_hash") @db.Char(64)
  expiresAt     DateTime    @map("expires_at")
  usedById      String?     @map("used_by_id") @db.Uuid
  usedAt        DateTime?   @map("used_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  familyGroup   FamilyGroup @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)
  usedBy        User?       @relation("FamilyInviteUser", fields: [usedById], references: [id], onDelete: SetNull)

  @@index([familyGroupId, expiresAt])
  @@map("family_invites")
}

model FamilyTaskAssignment {
  id             String                 @id @default(uuid()) @db.Uuid
  familyGroupId  String                 @map("family_group_id") @db.Uuid
  taskId         String                 @unique @map("task_id") @db.Uuid
  parentMemberId String                 @map("parent_member_id") @db.Uuid
  childMemberId  String                 @map("child_member_id") @db.Uuid
  status         FamilyAssignmentStatus @default(active)
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")
  familyGroup    FamilyGroup            @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)
  task           Task                   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  parentMember   FamilyMember           @relation("FamilyAssignmentParent", fields: [parentMemberId], references: [id], onDelete: Restrict)
  childMember    FamilyMember           @relation("FamilyAssignmentChild", fields: [childMemberId], references: [id], onDelete: Restrict)
  changeRequests TaskChangeRequest[]

  @@index([childMemberId, status])
  @@map("family_task_assignments")
}

model TaskChangeRequest {
  id               String                  @id @default(uuid()) @db.Uuid
  assignmentId     String                  @map("assignment_id") @db.Uuid
  childMemberId    String                  @map("child_member_id") @db.Uuid
  requestType      TaskChangeRequestType   @map("request_type")
  reason           String
  proposedPatch    Json?                   @map("proposed_patch")
  status           TaskChangeRequestStatus @default(pending)
  reviewedByUserId String?                 @map("reviewed_by_user_id") @db.Uuid
  reviewedAt       DateTime?               @map("reviewed_at")
  createdAt        DateTime                @default(now()) @map("created_at")
  assignment       FamilyTaskAssignment    @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  childMember      FamilyMember            @relation("FamilyChangeChild", fields: [childMemberId], references: [id], onDelete: Restrict)
  reviewedBy       User?                   @relation("FamilyChangeReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([assignmentId, status])
  @@map("task_change_requests")
}

model Reward {
  id          String        @id @default(uuid()) @db.Uuid
  name        String        @db.VarChar(160)
  description String
  rewardType  RewardType    @map("reward_type")
  imageUrl    String?       @map("image_url")
  inventory   Int?
  active      Boolean       @default(true)
  config      Json          @default("{}")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  claims      RewardClaim[]

  @@index([active, createdAt])
  @@map("rewards")
}

model RewardClaim {
  id          String            @id @default(uuid()) @db.Uuid
  rewardId    String            @map("reward_id") @db.Uuid
  userId      String            @map("user_id") @db.Uuid
  status      RewardClaimStatus @default(pending)
  acceptedAt  DateTime?         @map("accepted_at")
  fulfilledAt DateTime?         @map("fulfilled_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  reward      Reward            @relation(fields: [rewardId], references: [id], onDelete: Restrict)
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([rewardId, userId])
  @@index([userId, status])
  @@map("reward_claims")
}

model RewardAddress {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @unique @map("user_id") @db.Uuid
  encryptedValue String   @map("encrypted_value")
  valueHash      String   @map("value_hash") @db.Char(64)
  updatedAt      DateTime @updatedAt @map("updated_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reward_addresses")
}

model RewardAudit {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  claimId    String?  @map("claim_id") @db.Uuid
  action     String   @db.VarChar(80)
  targetHash String?  @map("target_hash") @db.Char(64)
  createdAt  DateTime @default(now()) @map("created_at")
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([claimId, createdAt])
  @@map("reward_audits")
}

model SecurityEvent {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  category   String   @db.VarChar(32)
  action     String   @db.VarChar(80)
  outcome    String   @db.VarChar(24)
  targetType String?  @map("target_type") @db.VarChar(48)
  targetHash String?  @map("target_hash") @db.Char(64)
  requestId  String?  @map("request_id") @db.VarChar(128)
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([category, action, createdAt])
  @@index([actorId, createdAt])
  @@index([requestId])
  @@map("security_events")
}

model Friendship {
  id           String           @id @default(uuid()) @db.Uuid
  requesterId  String           @map("requester_id") @db.Uuid
  addresseeId  String           @map("addressee_id") @db.Uuid
  pairKey      String           @unique @map("pair_key") @db.VarChar(73)
  status       FriendshipStatus @default(pending)
  respondedAt  DateTime?        @map("responded_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  requester    User             @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee    User             @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@index([requesterId, status])
  @@index([addresseeId, status])
  @@map("friendships")
}


model UserBlock {
  id         String   @id @default(uuid()) @db.Uuid
  blockerId  String   @map("blocker_id") @db.Uuid
  blockedId  String   @map("blocked_id") @db.Uuid
  reason     String?  @db.VarChar(120)
  createdAt  DateTime @default(now()) @map("created_at")
  blocker    User     @relation("UserBlocksCreated", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked    User     @relation("UserBlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_blocks")
}

model PkMatch {
  id            String        @id @default(uuid()) @db.Uuid
  challengerId  String        @map("challenger_id") @db.Uuid
  opponentId    String        @map("opponent_id") @db.Uuid
  matchDate     DateTime      @map("match_date") @db.Date
  pairDateKey   String        @unique @map("pair_date_key") @db.VarChar(84)
  status        PkMatchStatus @default(active)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  challenger    User          @relation("PkChallenger", fields: [challengerId], references: [id], onDelete: Cascade)
  opponent      User          @relation("PkOpponent", fields: [opponentId], references: [id], onDelete: Cascade)

  @@index([challengerId, matchDate])
  @@index([opponentId, matchDate])
  @@map("pk_matches")
}

model StudyRoom {
  id          String              @id @default(uuid()) @db.Uuid
  ownerId     String              @map("owner_id") @db.Uuid
  name        String              @db.VarChar(120)
  visibility  StudyRoomVisibility @default(public)
  inviteCode  String?             @unique @map("invite_code") @db.VarChar(16)
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  owner       User                @relation("StudyRoomOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     StudyRoomMember[]
  reactions   StudyRoomReaction[]

  @@index([visibility, createdAt])
  @@map("study_rooms")
}

model StudyRoomMember {
  id          String    @id @default(uuid()) @db.Uuid
  roomId      String    @map("room_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  joinedAt    DateTime  @default(now()) @map("joined_at")
  leftAt      DateTime? @map("left_at")
  room        StudyRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId, leftAt])
  @@map("study_room_members")
}

model StudyRoomReaction {
  id          String    @id @default(uuid()) @db.Uuid
  roomId      String    @map("room_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  emoji       String    @db.VarChar(24)
  createdAt   DateTime  @default(now()) @map("created_at")
  room        StudyRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
  @@map("study_room_reactions")
}

model DeviceSession {
  id                 String    @id @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  deviceName         String    @map("device_name") @db.VarChar(120)
  refreshTokenHash   String    @map("refresh_token_hash") @db.Char(64)
  expiresAt          DateTime  @map("expires_at")
  revokedAt          DateTime? @map("revoked_at")
  lastUsedAt         DateTime  @default(now()) @map("last_used_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@map("device_sessions")
}
